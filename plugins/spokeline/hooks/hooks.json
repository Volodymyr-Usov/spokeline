{
  "description": "Spokeline: voice in and spoken answers out",
  "modules": [
    "./register.js"
  ],
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/permission-hook.sh"
            ],
            "timeout": 140,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/permission-hook.mjs"
            ],
            "timeout": 140,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
